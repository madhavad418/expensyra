# JSAN SpendOps - deployment configuration
HOST=0.0.0.0
# Railway sets PORT itself; this is only the local default.
PORT=4173
BUSINESS_TZ=Asia/Kolkata

# --- Database -------------------------------------------------------------
# Production (Railway): Postgres. On Railway set this to a reference variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# The schema is created automatically on first start; the database starts
# empty and is filled by Pleo syncs from the app. No local data is uploaded.
DATABASE_URL=
# Only needed when connecting over a public proxy that requires TLS.
DATABASE_SSL=false
# Local development without DATABASE_URL: a SQLite file.
DATABASE_PATH=./data/spendops.db

# Receipt cache. On Railway the container disk is wiped on every deploy, so
# leave caching off: receipts are then fetched from Pleo when opened.
PLEO_CACHE_ATTACHMENTS=false
ATTACHMENT_DIR=/tmp/spendops-attachments

# Cookies must be Secure when deployed behind HTTPS.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
VALIDATION_IDLE_TIMEOUT_SECONDS=150

# --- Pleo -----------------------------------------------------------------
# NEVER commit the real key.
PLEO_API_BASE=https://external.pleo.io
PLEO_API_KEY=
PLEO_COMPANY_ID=
# Every Accounting Entry (what JSAN uses). Alternative: export_v2.
PLEO_SYNC_MODE=accounting_entries_v1
# Defaults are OFF so a fresh setup never calls Pleo until Test Connection
# succeeds. The daily sync is switched on from the Transactions page.
PLEO_AUTO_SYNC=false
PLEO_SYNC_ON_START=false
PLEO_SYNC_INTERVAL_MINUTES=15
PLEO_RECEIPT_CONCURRENCY=4
PLEO_RECEIPT_MAX_ATTEMPTS=5
# First-ever incremental sync fetches only this many hours; later syncs fetch since the last success.
PLEO_INITIAL_LOOKBACK_HOURS=24
# Daily sync defaults (the Transactions-page switch overrides these once used).
PLEO_DAILY_SYNC=false
PLEO_DAILY_SYNC_TIME=06:00

# CSV is only a recovery/reconciliation fallback.
ALLOW_RECOVERY_IMPORT=true

# Local testing only. Do not enable in production.
PLEO_MOCK_MODE=false
